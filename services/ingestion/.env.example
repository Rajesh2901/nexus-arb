# News Ingestion Microservice Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8001

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_KEY=stream:news:raw
REDIS_PUBSUB_CHANNEL=channel:news:realtime
DEDUP_SET_KEY=set:news:seen_hashes
DEDUP_TTL_SECONDS=86400

# External API Keys (Optional if ENABLE_SYNTHETIC_MOCKS is True)
ENABLE_SYNTHETIC_MOCKS=True
ALPHA_VANTAGE_API_KEY=demo
NEWS_API_KEY=

# Rate Limits (Requests per minute)
RATE_LIMIT_ALPHAVANTAGE_RPM=5
RATE_LIMIT_NEWSAPI_RPM=30
RATE_LIMIT_RSS_RPM=60

# Polling Frequencies (Seconds)
POLL_INTERVAL_JAPAN=15
POLL_INTERVAL_EUROPE=15
POLL_INTERVAL_AUSTRALIA=20
POLL_INTERVAL_MIDDLE_EAST=20
POLL_INTERVAL_ALPHAVANTAGE=60
